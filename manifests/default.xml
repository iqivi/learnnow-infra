<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote
        name="github"
        fetch="git@github.com:iqivi/" />

    <default
        remote="github"
        revision="main"
        upstream="main" />
    <project
        name="learnnow-ci"
        path="ci" />

    <project
        name="learnnow-webapp"
        path="web-app" />

    <project
        name="learnnow-backend"
        path="backend" />

    <project
        name="learnnow-db"
        path="db" />

    <project
        name="learnnow-infra"
        path="infra"
        revision="server"
        upstream="server" />
</manifest>