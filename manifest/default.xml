<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote
        name="github"
        fetch="git@github.com:iqivi/" />

    <!-- Domyślny branch dla wszystkich repo -->
    <default
        remote="github"
        revision="main" />

    <!-- CI -->
    <project
        name="learnnow-ci"
        path="ci" />

    <!-- Frontend -->
    <project
        name="learnnow-webapp"
        path="web-app" />

    <!-- Backend -->
    <project
        name="learnnow-backend"
        path="backend" />

    <!-- DB -->
    <project
        name="learnnow-db"
        path="db" />

    <!-- Infrastructure (nginx + compose) — branch: server -->
    <project
        name="learnnow-infra"
        path="infra"
        revision="server" />

</manifest>
